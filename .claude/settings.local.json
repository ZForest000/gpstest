{
  "permissions": {
    "allow": [
      "Bash(./gradlew assembleDebug)",
      "Bash(where java:*)",
      "Read(//c//**)",
      "Bash(reg query:*)",
      "Read(//c/Users/$USER/**)",
      "Read(//d//**)",
      "Bash(ls /d/jdk*)",
      "Read(//c/Program Files/Java/jdk-21/bin/**)",
      "Bash(\"/c/Program Files/Java/jdk-21/bin/java.exe\" -version)",
      "Bash(export JAVA_HOME=\"/c/Program Files/Java/jdk-21\")",
      "Bash(adb devices:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(./gradlew testDebugUnitTest --tests \"com.example.gpstest.domain.util.DopCalculatorTest\")",
      "Bash(find D:/project/gpstest/app/build -name TEST-*.xml -path *DopCalculator*)",
      "Bash(./gradlew testDebugUnitTest)",
      "Bash(./gradlew testDebugUnitTest --tests \"com.example.gpstest.domain.util.DopCalculatorTest\" --info)",
      "Bash(./gradlew clean:*)",
      "Bash(./gradlew ktlintCheck*)",
      "Bash(./gradlew ktlintFormat*)",
      "Bash(git diff *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/project/gpstest/.claude/hooks/block-sensitive.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'file=$(cat | grep -oP \"\\\"file_path\\\"\\s*:\\s*\\\"[^\\\"]+\\\"\" | head -1 | grep -oP \"\\\"[^\\\"]+\\\"$\" | tr -d \"\\\"\"); if [[ \"$file\" == *.kt ]]; then export JAVA_HOME=\"/c/Program Files/Java/jdk-21\" && cd D:/project/gpstest && ./gradlew ktlintFormat -q 2>/dev/null && echo \"[ktlint] 已自动格式化\"; fi'"
          }
        ]
      }
    ]
  }
}
